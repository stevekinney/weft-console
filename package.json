{
  "name": "@lostgradient/weft-console",
  "version": "0.1.0",
  "description": "Operator console for the Weft durable-workflow engine.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun scripts/dev-server.ts",
    "build": "vite build && bun run check:bundle",
    "check:bundle": "bun scripts/check-bundle-size.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,svelte,js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,svelte,js,json,md,css,html}\"",
    "test": "TZ=UTC bun test --conditions browser --conditions svelte"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lostgradient/cinder": "0.16.1",
    "@lostgradient/weft": "0.12.0",
    "@tanstack/svelte-query": "^5.90.2",
    "cron-parser": "^5.6.2",
    "lucide-svelte": "^0.577.0",
    "svelte": "^5.56.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.3.13",
    "happy-dom": "^20.11.0",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte-check": "^4.7.3",
    "typescript": "5.9.3",
    "vite": "^8.1.5"
  }
}
